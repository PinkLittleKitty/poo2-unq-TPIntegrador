<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.5.2 Chrome/142.0.7444.265 Electron/39.6.1 Safari/537.36" version="29.5.2">
  <diagram name="Page-1" id="MEMsVOg9I4byTbGzPSWV">
    <mxGraphModel dx="4320" dy="3167" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    Catalogo \&quot;*\&quot; &lt;-- \&quot;servicios\&quot; Cliente\n    Catalogo &lt;|-- ServicioIndividual\n    Catalogo &lt;|-- PaqueteTurístico\nPaqueteTurístico \&quot;Catalogos\&quot; o-- \&quot;*\&quot; Catalogo\n\nServicioIndividual --&gt; \&quot;1\&quot; Categoria : Categoria\nServicioIndividual *-- \&quot;*\&quot; DefinicionAtributo : atributosDinamicos\nDefinicionAtributo --&gt; \&quot;1\&quot; TipoDato : validaCon\n\nTipoDato &lt;|-- TipoTexto\nTipoDato &lt;|-- TipoNumerico\nTipoDato &lt;|-- TipoBooleano\nTipoDato &lt;|-- TipoFecha\n\nContextoReserva --&gt; \&quot;*\&quot; Catalogo : servicios\n%% Este sería nuestro cliente, y este mismo usaría ServicioTraslado para costear el transporte\n\nEstadoReserva &lt;--o ContextoReserva\nEstadoReserva &lt;|-- SolicitudPendiente\nEstadoReserva &lt;|-- Confirmada\nEstadoReserva &lt;|-- EnCheckin\nEstadoReserva &lt;|-- EnCurso\nEstadoReserva &lt;|-- Finalizada\nEstadoReserva &lt;|-- Cancelada\n\nSolicitudPendiente --&gt; Confirmada : Siguiente\nConfirmada --&gt; EnCheckin : Siguiente\nEnCheckin --&gt; EnCurso : Siguiente\nEnCurso --&gt; Finalizada : Siguiente\n\nclass Cliente {\n%% Es conceptual\n+ cliente(List&lt;Catalogo&gt;) cliente\n+ navegarCatalogo() void\n}\n\nclass Catalogo {\n&lt;&lt;Abstract&gt;&gt;\n- nombre : String\n- descripcion : String\n- precioBase : real\n- cupoDisponible : int\n+ agregarCupo(cupo) : int %% necesitamos decir cuantos cupos reservo?\n+ liberarCupo(cupo) : int\n+ getCupo() : int\n+ precioBase()* real\n+ precioFinal(descuento)* real\n+ catalogo(nombre, descripcion) Catalogo\n}\n\nclass ServicioIndividual {\n- ID : int\n- proovedor : String\n- precioBase : real\n- categoria : Categoria\n+ precioBase() real\n+ precioFinal(descuento) real\n+ proovedor() String\n+ categoria() Categoria\n+ esValido() boolean\n+ agregarAtributo(atributo : DefinicionAtributo) void\n+ servicioIndividual(precio, nombre, descripcion) ServicioIndividual\n}\n\nclass PaqueteTurístico {\n- descuento : real\n+ PaqueteTurístico(List&lt;Catalogo&gt;, descuento, nombre, descripcion)\n+ agregarCupo(cupo) : int %% aca tenemos que reescribirla logica para la lista interna del paquete.\n+ liberarCupo(cupo) : int\n+ porcentaje()\n+ setDescuento()\n+ precioBase() real\n+ precioFinal(descuento) real\n+ AddCatalogo()\n+ RemoveCatalogo()\n+ GetCatalogo()\n}\n\n\nclass Categoria {\n&lt;&lt;Enumeration&gt;&gt;\nVUELO\nEXCURSION\nALOJAMIENTO\nALQUILER_DE_AUTOS\n}\n\nclass DefinicionAtributo {\n- nombre : String\n- esObligatorio : boolean\n- valor : Object\n+ validar() boolean\n+ esObligatorio() boolean\n+ getNombre() String\n}\n\nclass TipoDato {\n&lt;&lt;interface&gt;&gt;\n+ esValido(valor : Object)\n}\n\nclass TipoTexto {\n+ esValido(valor : Object)\n}\n\nclass TipoNumerico {\n+ esValido(valor : Object)\n}\n\nclass TipoBooleano {\n+ esValido(valor : Object)\n}\n\nclass TipoFecha {\n+ esValido(valor : Object)\n}\n\nclass ContextoReserva {\n- estadoActual : EstadoReserva\n- servicios : List&lt;Catalogo&gt;\n\n+ getEstadoActual() EstadoReserva\n+ setEstado(EstadosReserva) void\n+ siguiente() void\n+ cancelar() void\n+ agregarServicio(Catalogo) void\n+ quitarServicio(Catalogo) void\n+ liberarCupos() void %% no deberia ser para todos\n+ decrementarCupos() void %% stream que recorra -servicios- y llame liberarCupo(serv.getCupo())\n+ solicitarReembolso() void %% delega a otra cosa de pagos\n- verificacionAgregarQuitarServicio()\n- generarVoucher()\n}\n\nclass EstadoReserva {\n&lt;&lt;abstract&gt;&gt;\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass SolicitudPendiente {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass Confirmada {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass EnCheckin {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass EnCurso {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass Finalizada {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nclass Cancelada {\nsiguiente() EstadoReserva\ncancelar() EstadoReserva\n}\n\nTraslado -- Adaptador\nAdaptador --&gt; TrasladoEstandar\nAdaptador --&gt; TrasladoVip\nAdaptador --&gt; SinTraslado\n\nclass Traslado {\ncosto()\n}\n\nclass Adaptador {\ncosto()\n}\n\nclass TrasladoEstandar {\nestimarTraslado(int cantidadPasajeros, Direccion direccionDestino)\n}\n\nclass TrasladoVip {\n# Donde dice \&quot;El costo se calcula como porcentaje fijo sobre el valor total de la reserva\&quot; (relacionar esto con precio total de los servicios/paquetes turísticos)\ncalcularCosto(float precio)\n}\n\nclass SinTraslado {\ncosto() # Qué onda con la estimación?\n}\n\nMetodoDePago &lt;|-- TarjetaCreditoInteracional\nMetodoDePago &lt;|-- TransferenciaBancaria\nMetodoDePago &lt;|-- BilleteraVirtual\n\n\nclass MetodoDePago {\n&lt;&lt;Abstract&gt;&gt;\nProcesarPago()* # Este método tendría los cuatro en orden, hook, no lo implementan los otros\nvalidarDatos()*\nreservarFondos()*\nejecutarTransaccion()*\nnotificarResultado()\n}\n\nclass TarjetaCreditoInteracional {\n- nroTarjeta\n- cvv\n- vencimiento\nvalidarDatos()\nreservarFondos()\nejecutarTransaccion()\nnotificarResultado()\n}\n\nclass TransferenciaBancaria {\n- cbu\n- alias\nvalidarDatos()\nreservarFondos()\nejecutarTransaccion()\nnotificarResultado()\n}\n\nclass BilleteraVirtual {\n- saldo\nvalidarDatos()\nreservarFondos()\nejecutarTransaccion()\nnotificarResultado()\n}\n\nObservadorAbstracto &lt;|-- NotificadorMail\nObservadorAbstracto &lt;|-- GeneradorFactura\nObservadorAbstracto &lt;|-- Fidelización\n\nclass ObservadorAbstracto {\n&lt;&lt;Abstract&gt;&gt;\nactualizar(Reserva)*\n}\n\nclass NotificadorMail {\nactualizar(Reserva) # La reserva puede estar CONFIRMADA, EN_CURSO y FINALIZADA.\n# persona.enviarMail(String direccionDestino, String titulo, String mensaje, Object adjunto)\n}\n\nclass GeneradorFactura {\nactualizar(Reserva)\n}\n\nclass Fidelización {\nactualizar(Reserva)\n}\n\n\nclass Reporte {\n\n&lt;&lt;interface&gt;&gt;\n+accept(v: FormatoVisitante) void\n+calcularDatos(c:catalogo)\n}\n\nclass ServicioMasReservado {\n\n-String atributo\n+masReservados()\n\n+accept(v: FormatoVisitante) void\n%% v.servicioMasReservado(this)\n\n\n+calcularDatos(c:catalogo)\n%%ret calcula datos no los guarda\n\n}\n\nclass RegistroDeCupos {\n\n-String atributo\n\n+registroCupos(ca)\n%%implementa cosas de registro de cupos\n\n+accept(v: FormatoVisitante) void\n\n+calcularDatos(c:catalogo)\n%%ret calcula datos no los guarda\n\n}\n\nclass RegistroDeOperadores {\n\n+registrarOperadores()\n%%implementa cosas de operadores del servicio\n\n+accept(v: FormatoVisitante) void\n\n+calcularDatos(c:catalogo)\n%%ret calcula datos no los guarda\n\n}\n\n\n\nclass FormatoVisitante {\n\n&lt;&lt;interface&gt;&gt;\n+visitar(e: ServicioMasReservado) void\n+visitar(e: RegistroDeCupos) void\n+visitar(e: RegistroDeOperadores) void\n+obtenerReporte() string\n}\n\nclass FormatoHtml {\n\n%% NOSE DE que tipo es esto\n-reporteHtml\n\n+visitar(e: ServicioMasReservado) void\n%% reporteHtml =  e.pideCosasALaClase\n\n+visitar(e: RegistroDeCupos) void\n+visitar(e: RegistroDeOperadores) void\n+obtenerReporte() string\n}\n\nclass FormatoCsv {\n\n%% NOSE DE que tipo es esto\n-reporteCsv\n\n+visitar(e: ServicioMasReservado) void\n%% aca retorna la informacion para exportar\ne.pideCosasALaClase\n\n+visitar(e: RegistroDeCupos) void\n+visitar(e: RegistroDeOperadores) void\n+obtenerReporte() string\n}\n\n\nclass FormatoTextoPlano {\n\n%% NOSE DE que tipo es esto\n-reporteTextoPlano\n\n+visitar(e: ServicioMasReservado) void\n%% aca retorna la informacion para exportar\ne.pideCosasALaClase\n\n+visitar(e: RegistroDeCupos) void\n+visitar(e: RegistroDeOperadores) void\n+obtenerReporte() string\n}\n\n%%implementan interfaces\nReporte &lt;|-- ServicioMasReservado\nReporte &lt;|-- RegistroDeCupos\nReporte &lt;|-- RegistroDeOperadores\n\n%%implementan interfaces\nFormatoVisitante &lt;|-- FormatoHtml\nFormatoVisitante &lt;|-- FormatoCsv\nFormatoVisitante &lt;|-- FormatoTextoPlano\n\n%% interface formato visitante conoce \n%% a reporte mas reservado\nReporte ..&gt; FormatoVisitante\nFormatoVisitante ..&gt; ServicioMasReservado\nServicioMasReservado ..&gt; Catalogo\nRegistroDeCupos ..&gt; Catalogo\nRegistroDeOperadores ..&gt; Catalogo\n\n%%HtmlVisitante ..&gt; ReporteMasReservado : usa\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="ZZgvrB4KK3xxg64uMziT-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="120" x="-290" y="1410" as="geometry" />
          </mxCell>
        </UserObject>
